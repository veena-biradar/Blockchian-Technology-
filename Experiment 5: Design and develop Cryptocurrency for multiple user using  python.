import hashlib 
import json 
import base64 
import time 
import uuid 
 
from cryptography.hazmat.primitives.asymmetric.ed25519 import ( 
    Ed25519PrivateKey, 
    Ed25519PublicKey, 
) 
from cryptography.hazmat.primitives import serialization 
 
 
def sha256(data): 
    if isinstance(data, str): 
        data = data.encode("utf-8") 
    return hashlib.sha256(data).hexdigest() 
 
 
def canonical_json(data): 
    return json.dumps(data, sort_keys=True, separators=(",", ":")) 
 
 
class Wallet: 
    def __init__(self): 
        self.private_key = Ed25519PrivateKey.generate() 
        self.public_key = self.private_key.public_key() 
 
        public_bytes = self.public_key.public_bytes( 
            encoding=serialization.Encoding.Raw, 
            format=serialization.PublicFormat.Raw, 
        ) 
 
        self.public_key_text = base64.b64encode( 
            public_bytes 
        ).decode() 
 
        self.address = sha256(public_bytes)[:40] 
 
    def sign(self, transaction): 
        message = canonical_json(transaction).encode() 
        signature = self.private_key.sign(message) 
        return base64.b64encode(signature).decode() 
 
 
class Block: 
    def __init__(self, index, transactions, previous_hash): 
        self.index = index 
        self.timestamp = time.time() 
        self.transactions = transactions 
        self.previous_hash = previous_hash 
        self.hash = self.calculate_hash() 
 
    def calculate_hash(self): 
        block_data = { 
            "index": self.index, 
            "timestamp": self.timestamp, 
            "transactions": self.transactions, 
            "previous_hash": self.previous_hash, 
        } 
        return sha256(canonical_json(block_data)) 
 
 
class PyCoin: 
    def __init__(self, initial_balances): 
        # Trusted initial allocation for this educational demo 
        self.initial_balances = dict(initial_balances) 
 
        genesis = Block(0, [], "0") 
        self.chain = [genesis] 
 
    def balance(self, address): 
        amount = self.initial_balances.get(address, 0) 
 
        for block in self.chain[1:]: 
            for tx in block.transactions: 
                if tx["sender"] == address: 
                    amount -= tx["amount"] 
                if tx["recipient"] == address: 
                    amount += tx["amount"] 
 
        return amount 
 
    def verify_transaction(self, tx): 
        try: 
            amount = tx["amount"] 
 
            if type(amount) is not int or amount <= 0: 
                return False 
 
            if not isinstance(tx["recipient"], str): 
                return False 
 
            public_bytes = base64.b64decode( 
                tx["public_key"], validate=True 
            ) 
 
            if sha256(public_bytes)[:40] != tx["sender"]: 
                return False 
 
            public_key = Ed25519PublicKey.from_public_bytes( 
                public_bytes 
            ) 
 
            signed_data = { 
                "id": tx["id"], 
                "sender": tx["sender"], 
                "recipient": tx["recipient"], 
                "amount": amount, 
            } 
 
            signature = base64.b64decode( 
                tx["signature"], validate=True 
            ) 
 
            public_key.verify( 
                signature, 
                canonical_json(signed_data).encode(), 
            ) 
 
            return True 
 
        except (ValueError, TypeError, KeyError, Exception): 
            return False 
 
    def transfer(self, sender_wallet, recipient, amount): 
        if type(amount) is not int or amount <= 0: 
            print("Transfer rejected: amount must be positive.") 
            return False 
 
        if self.balance(sender_wallet.address) < amount: 
            print("Transfer rejected: insufficient balance.") 
            return False 
 
        tx = { 
            "id": str(uuid.uuid4()), 
            "sender": sender_wallet.address, 
            "recipient": recipient, 
            "amount": amount, 
            "public_key": sender_wallet.public_key_text, 
        } 
 
        # Sign the transaction fields, excluding the signature itself 
        signed_data = { 
            "id": tx["id"], 
            "sender": tx["sender"], 
            "recipient": tx["recipient"], 
            "amount": tx["amount"], 
        } 
 
        tx["signature"] = sender_wallet.sign(signed_data) 
 
        if not self.verify_transaction(tx): 
            print("Transfer rejected: invalid signature.") 
            return False 
 
        previous_hash = self.chain[-1].hash 
        block = Block(len(self.chain), [tx], previous_hash) 
        self.chain.append(block) 
 
        print("Transfer successful!") 
        print("Transaction ID:", tx["id"]) 
        print("Block hash:", block.hash) 
        return True 
 
    def verify_chain(self): 
        if not self.chain: 
            return False 
 
        genesis = self.chain[0] 
 
        if ( 
            genesis.index != 0 
            or genesis.previous_hash != "0" 
            or genesis.transactions != [] 
            or genesis.hash != genesis.calculate_hash() 
        ): 
            return False 
 
        balances = dict(self.initial_balances) 
 
        for i, block in enumerate(self.chain[1:], start=1): 
            if block.index != i: 
                return False 
 
            if block.previous_hash != self.chain[i - 1].hash: 
                return False 
 
            if block.hash != block.calculate_hash(): 
                return False 
 
            for tx in block.transactions: 
                if not self.verify_transaction(tx): 
                    return False 
 
                sender = tx["sender"] 
                recipient = tx["recipient"] 
                amount = tx["amount"] 
 
                if balances.get(sender, 0) < amount: 
                    return False 
 
                balances[sender] = balances.get(sender, 0) - amount 
                balances[recipient] = ( 
                    balances.get(recipient, 0) + amount 
                ) 
 
        return True 
 
    def display_chain(self): 
        for block in self.chain: 
            print("\nBlock:", block.index) 
            print("Previous hash:", block.previous_hash) 
            print("Block hash:", block.hash) 
 
            for tx in block.transactions: 
                print( 
                    tx["sender"], "->", tx["recipient"], 
                    "| Amount:", tx["amount"], "PyCoin" 
                ) 
 
 
