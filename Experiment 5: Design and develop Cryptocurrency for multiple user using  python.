if __name__ == "__main__": 
    alice = Wallet() 
    bob = Wallet() 
    charlie = Wallet() 
 
    # Create initial balances for the demonstration 
    coin = PyCoin({ 
        alice.address: 100, 
        bob.address: 100, 
        charlie.address: 100, 
    }) 
 
    print("=== PyCoin Cryptocurrency ===") 
    print("Alice:", alice.address) 
    print("Bob:", bob.address) 
    print("Charlie:", charlie.address) 
 
    print("\nInitial balances:") 
    for name, wallet in [ 
        ("Alice", alice), 
        ("Bob", bob), 
        ("Charlie", charlie), 
    ]: 
        print(name, ":", coin.balance(wallet.address), "PyCoin") 
 
    print("\n=== Transactions ===") 
    coin.transfer(alice, bob.address, 25) 
    coin.transfer(bob, charlie.address, 10) 
    coin.transfer(charlie, alice.address, 5) 
 
    print("\n=== Final balances ===") 
    for name, wallet in [ 
        ("Alice", alice), 
        ("Bob", bob), 
        ("Charlie", charlie), 
    ]: 
        print(name, ":", coin.balance(wallet.address), "PyCoin") 
 
    print("\nBlockchain integrity:", coin.verify_chain()) 
 
    print("\n=== Blockchain details ===") 
    coin.display_chain() 
 
    print("\n=== Tampering test ===") 
    coin.chain[1].transactions[0]["amount"] = 90 
    print("Blockchain integrity after tampering:", 
          coin.verify_chain()) 
